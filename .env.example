# ─────────────────────────────────────────────────────────────────────────────
# Praxis local configuration. Copy to .env — `make up` / core boot validate this.
# Missing REQUIRED values fail fast with a clear message.
# ─────────────────────────────────────────────────────────────────────────────

# --- general ---
NODE_ENV=development
PRAXIS_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# --- core API ---
CORE_HTTP_PORT=3000
API_PREFIX=/api/v1

# --- auth (REQUIRED) ---
JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_ACCESS_TTL=900            # seconds
JWT_REFRESH_TTL=1209600       # seconds (14d)

# --- database (REQUIRED) ---
DATABASE_URL=postgres://praxis:praxis@localhost:5433/praxis
DATABASE_SSL=false

# --- redis (REQUIRED) ---
REDIS_URL=redis://localhost:6379

# --- event bus ---
EVENT_BUS_DRIVER=redis-streams   # memory | redis-streams
EVENT_BUS_STREAM_MAXLEN=100000

# --- human-in-the-loop gates (prd/06 §5, FR-APPROVE) ---
REQUIRE_PLAN_APPROVAL=true
REQUIRE_DELIVERY_APPROVAL=false

# --- temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=praxis-runs

# --- agent runtime ---
AGENT_RUNTIME_URL=http://localhost:8081

# --- sandbox (ADR-0005) ---
SANDBOX_BACKEND=docker           # docker | none  (docker = local/demo, NOT an isolation boundary)
SANDBOX_IMAGE=praxis/sandbox:local
SANDBOX_WORKDIR=/workspace
SANDBOX_DOCKER_NETWORK=bridge

# --- connector secrets (interim at-rest encryption; real SecretsProvider later) ---
# base64 of 32 random bytes. If blank, a key is derived from JWT_SECRET (dev only).
SECRETS_ENCRYPTION_KEY=

# --- model gateway (LiteLLM) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-praxis-dev
# Provider keys — optional locally; the stub model works without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- object storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=praxis
S3_SECRET_KEY=praxis-secret
S3_BUCKET=praxis-artifacts
S3_FORCE_PATH_STYLE=true

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=praxis

# --- seed / demo ---
SEED_DEMO=true
DEMO_TENANT_NAME=Acme
DEMO_ADMIN_EMAIL=admin@praxis.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
