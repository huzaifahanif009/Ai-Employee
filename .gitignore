# deps
node_modules/
.venv/
__pycache__/
*.egg-info/

# build
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# tooling
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# data volumes (compose bind mounts, if any)
/.data/

# generated
packages/event-schemas/src/generated/
services/*/src/**/generated/

# never track compiled output that lands next to sources
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map

# claude code local state
.claude/

# nested lockfile — root package-lock.json governs the workspace
services/dashboard/package-lock.json
